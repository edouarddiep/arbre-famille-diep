{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "arbre-famille-diep": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "docs",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "polyfills": [],
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "src",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "src/assets/art",
                "output": "assets/art"
              },
              {
                "glob": "**/*",
                "input": "src/assets/photos",
                "output": "assets/photos"
              },
              {
                "glob": "**/*",
                "input": "src/assets/clips",
                "output": "assets/clips"
              },
              {
                "glob": "**/*",
                "input": "src/assets/audio",
                "output": "assets/audio"
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/arbre-famille-diep/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "48kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "arbre-famille-diep:build:production"
            },
            "development": {
              "buildTarget": "arbre-famille-diep:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "arbre-famille-diep:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "9c020411-39f1-41e5-a1b0-2bcef252dc9d"
  }
}
